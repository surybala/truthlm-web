# Copy to orl-web/.env for local runs; the server and alembic load it automatically.
# Variables already set in your shell or deployment take precedence. Restart after editing.
ORL_WEB_ENV=development
# Local Postgres from `docker compose up -d postgres`; use sqlite:///./orl-web.db for a quick start.
ORL_WEB_DATABASE_URL=postgresql+psycopg://orl_web:local-development-only@127.0.0.1:5432/orl_web
ORL_WEB_JWT_SECRET=replace-with-at-least-32-random-characters
ORL_WEB_JWT_ISSUER=orl-auth
ORL_WEB_JWT_AUDIENCE=orl-web
ORL_WEB_QUESTION_LIMIT_PER_HOUR=5
ORL_WEB_VOTE_LIMIT_PER_HOUR=60
ORL_WEB_REPORT_LIMIT_PER_HOUR=10
ORL_WEB_MAGIC_LINK_LIMIT_PER_HOUR=5
ORL_WEB_ACCESS_REQUEST_LIMIT_PER_HOUR=60
# invite: only approved addresses can sign in. open: everyone except revoked addresses.
ORL_WEB_ACCESS_MODE=invite
# Research domains questions may belong to. Add one only when an expert covers it.
ORL_WEB_DOMAINS=Economics,Finance,Mathematics,Statistics
ORL_WEB_BASE_URL=http://127.0.0.1:8080
ORL_WEB_SESSION_COOKIE_NAME=truthlm_session
ORL_WEB_SESSION_DAYS=30
ORL_WEB_MAGIC_LINK_MINUTES=15
# Development prints links to the server log. Production must use smtp.
ORL_WEB_EMAIL_DELIVERY=console
ORL_WEB_SMTP_HOST=
ORL_WEB_SMTP_PORT=587
ORL_WEB_SMTP_USERNAME=
ORL_WEB_SMTP_PASSWORD=
ORL_WEB_SMTP_FROM_EMAIL=
ORL_WEB_SMTP_STARTTLS=true
# Comma-separated. Accounts created by these addresses on their FIRST sign-in receive the role;
# set them before that sign-in. They can always sign in, even in invite mode.
ORL_WEB_ADMIN_EMAILS=
ORL_WEB_EDITOR_EMAILS=
