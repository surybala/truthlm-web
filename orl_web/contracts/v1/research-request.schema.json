{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.orl.dev/v1/research-request.schema.json",
  "title": "ORL research request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "cycle_id", "cluster_id", "question_revision", "question", "answer_format", "requested_at", "idempotency_key"],
  "properties": {
    "schema_version": {"const": "1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "cycle_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "cluster_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "question_revision": {"type": "integer", "minimum": 1},
    "question": {"type": "string", "minLength": 10, "maxLength": 2000},
    "answer_format": {"const": "long_form_article"},
    "requested_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 256}
  }
}
